:root {
}

.header {
    font-size: 40px;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("project://database/Assets/ImportedAssets/Delius-Regular.ttf?fileID=12800000&guid=5c690382c71217d42a685b8b84c0fe2d&type=3#Delius-Regular");
}

.button {
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    top: auto;
    width: 320px;
    height: 80px;
    position: relative;
    margin-top: 50px;
    font-size: 30px;
    -unity-font-definition: url("project://database/Assets/ImportedAssets/Delius-Regular.ttf?fileID=12800000&guid=5c690382c71217d42a685b8b84c0fe2d&type=3#Delius-Regular");
    -unity-font-style: bold;
}


